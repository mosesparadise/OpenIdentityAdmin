@page "/account/administrator/security/replacement"
@model IdentityPlatform.AuthServer.Features.Accounts.Security.ReplacementModel
@{ ViewData["Title"] = "Replace your authenticator"; }
<section class="card" aria-labelledby="heading">
  <p class="eyebrow">Account security</p>
  <h1 id="heading">Replace your authenticator</h1>
  <p>Verify your password and current authenticator first. Your existing authenticator stays active until you confirm the new one.</p>
  @if (Model.Error is not null)
  {
    <div id="error-summary" class="error-summary" tabindex="-1"><p>@Model.Error</p></div>
  }
  <form asp-antiforgery="true" method="post" action="/account/administrator/security/replacement"><partial name="/Features/Accounts/Shared/_AdministratorPassword.cshtml" /></form>
  <p class="footnote"><a href="/account/administrator/login">Return to sign in</a></p>
</section>
