<div class="field">
  <label for="username">Username</label>
  <input id="username" name="Username" type="text" required maxlength="128" autocomplete="username" autocapitalize="none" spellcheck="false" />
</div>
<div class="field">
  <label for="password">Password</label>
  <div class="password-field"><input id="password" name="Password" type="password" required maxlength="256" autocomplete="current-password" /><button id="show-password" type="button" hidden>Show password</button></div>
</div>
<button type="submit" class="primary" id="submit">Continue <span aria-hidden="true">→</span></button>
