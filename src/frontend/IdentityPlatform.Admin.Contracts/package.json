{
  "name": "@identityplatform/admin-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "generate": "node tooling/prepare-generator.mjs && node tooling/generate.mjs",
    "check": "node tooling/prepare-generator.mjs --check && node tooling/generate.mjs --check && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "bundle": "esbuild tests/consumer.ts --bundle --format=iife --global-name=contractConsumer --outfile=dist/consumer.js --platform=browser",
    "prepare:generator": "node tooling/prepare-generator.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "@redocly/openapi-core": "2.71.2"
  },
  "overrides": {
    "openapi-typescript": {
      "@redocly/openapi-core": {
        ".": "1.34.23",
        "minimatch": "11.0.4"
      }
    }
  }
}
