                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized",
            "headers": {
              "Cache-Control": {
                "description": "Application data must not be cached.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden",
            "headers": {
              "Cache-Control": {
                "description": "Application data must not be cached.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              }
            }
