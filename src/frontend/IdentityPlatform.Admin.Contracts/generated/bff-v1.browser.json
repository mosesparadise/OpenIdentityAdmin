{
  "components": {
    "schemas": {
      "ApplicationAntiforgeryToken": {
        "properties": {
          "requestToken": {
            "type": "string"
          }
        },
        "required": [
          "requestToken"
        ],
        "type": "object"
      },
      "ApplicationCreate": {
        "properties": {
          "clientId": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "credentialExpiresAt": {
            "type": "string"
          },
          "displayName": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "redirectUris": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "clientId",
          "displayName",
          "redirectUris",
          "credentialExpiresAt"
        ],
        "type": "object"
      },
      "ApplicationCredentialMetadata": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "issuedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "issuedAt",
          "expiresAt"
        ],
        "type": "object"
      },
      "ApplicationCredentialOutput": {
        "properties": {
          "application": {
            "$ref": "#/components/schemas/ApplicationDetails"
          },
          "clientSecret": {
            "type": "string"
          }
        },
        "required": [
          "application",
          "clientSecret"
        ],
        "type": "object"
      },
      "ApplicationDetails": {
        "properties": {
          "clientId": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "credential": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ApplicationCredentialMetadata"
              }
            ]
          },
          "displayName": {
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ]
          },
          "editable": {
            "type": "boolean"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          },
          "profile": {
            "type": [
              "null",
              "string"
            ]
          },
          "redirectUris": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          }
        },
        "required": [
          "id",
          "clientId",
          "displayName",
          "redirectUris",
          "profile",
          "editable",
          "credential",
          "expiresAt"
        ],
        "type": "object"
      },
      "ApplicationPage": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "hasNextPage": {
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ApplicationSummary"
            },
            "maxItems": 100,
            "type": "array"
          },
          "page": {
            "format": "int32",
            "maximum": 10000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "pageSize": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "hasNextPage",
          "expiresAt"
        ],
        "type": "object"
      },
      "ApplicationSummary": {
        "properties": {
          "clientId": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "clientType": {
            "maxLength": 50,
            "type": [
              "null",
              "string"
            ]
          },
          "displayName": {
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ]
          },
          "id": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "clientId",
          "displayName",
          "clientType"
        ],
        "type": "object"
      },
      "BrowserSessionStatus": {
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "expiresAt": {
            "format": "date-time",
            "type": [
              "null",
              "string"
            ]
          },
          "subject": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "authenticated"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "BrowserSession": {
        "in": "cookie",
        "name": "__Host-identity-admin-session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Contract foundation. No production management operations are implemented.",
    "title": "IdentityPlatform Admin BFF browser API",
    "version": "1"
  },
  "openapi": "3.1.1",
