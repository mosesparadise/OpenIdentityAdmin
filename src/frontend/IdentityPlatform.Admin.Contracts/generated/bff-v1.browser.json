          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service Unavailable",
            "headers": {
              "Cache-Control": {
                "description": "Application data and generated credentials must not be cached.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "BrowserSession": []
