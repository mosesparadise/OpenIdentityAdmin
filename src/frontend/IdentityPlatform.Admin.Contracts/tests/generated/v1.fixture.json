{
  "components": {
    "schemas": {
      "Contact": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/ContactEmailContact"
          },
          {
            "$ref": "#/components/schemas/ContactPhoneContact"
          }
        ],
        "discriminator": {
          "mapping": {
            "email": "#/components/schemas/ContactEmailContact",
            "phone": "#/components/schemas/ContactPhoneContact"
          },
          "propertyName": "kind"
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "ContactEmailContact": {
        "properties": {
          "email": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "email"
            ],
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "ContactPhoneContact": {
        "properties": {
          "kind": {
            "enum": [
              "phone"
            ],
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "phone"
        ]
      },
      "Example": {
        "properties": {
          "contact": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Contact"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": [
              "null",
              "string"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/ExampleState"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "state",
          "updatedAt"
        ],
        "type": "object"
      },
      "ExamplePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Example"
            },
            "type": "array"
          },
          "pageSize": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "items",
          "pageSize"
        ],
        "type": "object"
      },
      "ExampleState": {
        "enum": [
          "Active",
          "Disabled"
        ]
      },
      "ExampleUpdate": {
        "properties": {
          "label": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "AdminBearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "NON-SHIPPED tooling fixture. <img alt=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\" onload=window.fixtureInjected=true>",
    "title": "IdentityPlatform Admin API",
    "version": "1"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/examples": {
      "get": {
        "operationId": "ListExamples",
        "parameters": [
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "default": 25,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExamplePage"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "AdminBearer": []
          }
        ],
        "summary": "List synthetic examples",
        "tags": [
          "IdentityPlatform.Api.Contracts.Tests"
        ],
        "x-required-permission": "examples.read"
      }
    },
    "/api/v1/examples/{id}": {
      "get": {
        "operationId": "GetExample",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Example"
                }
              }
            },
            "description": "OK",
            "headers": {
              "ETag": {
                "description": "Version required for edits",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "security": [
          {
            "AdminBearer": []
          }
        ],
        "summary": "Get a synthetic example",
        "tags": [
          "IdentityPlatform.Api.Contracts.Tests"
        ],
        "x-required-permission": "examples.read"
      },
      "put": {
        "operationId": "UpdateExample",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExampleUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Example"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Precondition Failed"
          },
          "428": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Precondition Required"
          }
        },
        "security": [
          {
            "AdminBearer": []
          }
        ],
        "summary": "Update a synthetic example",
        "tags": [
          "IdentityPlatform.Api.Contracts.Tests"
        ],
        "x-required-permission": "examples.write"
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "IdentityPlatform.Api.Contracts.Tests"
    }
  ]
}
